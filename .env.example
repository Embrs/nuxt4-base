# 環境變數範本
# 用法：複製本檔為 .env（本機機密，已被 .gitignore 忽略），再填入實際值。
# 注意：.env 與 .env.dev 皆禁止填入任何真實密碼後提交。

# ===== 必填 =====
# API 基礎網址
NUXT_API_BASE=http://localhost

# ===== Public（前端可讀，會打包進客戶端）=====
# 測試模式開關
NUXT_PUBLIC_TEST_MODE=T
# Google Tag Manager ID（選填，未啟用可留空）
NUXT_PUBLIC_GTM_ID=
# Microsoft Clarity 代碼（選填，未啟用可留空）
NUXT_PUBLIC_CLARITY_CODE=

# ===== 後端（啟用 server/ 後再填，純前端樣板可忽略）=====
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=dbname

# ----- Cloudflare R2 物件儲存（檔案上傳/下載）-----
# 啟用步驟與機制詳見 .claude/knowledge/r2-storage.md
# 先安裝套件：npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# R2_ACCOUNT_ID=              # Cloudflare 帳戶 ID（組成 endpoint，不含 bucket 名）
# R2_ACCESS_KEY_ID=           # R2 API Token 的 Access Key ID
# R2_SECRET_ACCESS_KEY=       # R2 API Token 的 Secret（機密；永不可進 repo / 前端 bundle）
# R2_BUCKET_NAME=your-bucket  # Bucket 名稱

# 檔案大小上限（MB，選填，留空走預設）
# MAX_ZIP_SIZE_MB=1024
# MAX_IMAGE_SIZE_MB=20
# MAX_VIDEO_SIZE_MB=100
# MAX_OTHER_SIZE_MB=1024
