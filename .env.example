# 環境變數範本
# 用法：複製本檔為 .env（本機機密，已被 .gitignore 忽略），再填入實際值。
# 注意：.env 與 .env.dev 皆禁止填入任何真實密碼後提交。

# ===== 必填 =====
# API 基礎網址
NUXT_API_BASE=http://localhost

# ===== Public（前端可讀，會打包進客戶端）=====
# 測試模式開關
NUXT_PUBLIC_TEST_MODE=T
# Google Tag Manager ID（選填，未啟用可留空）
NUXT_PUBLIC_GTM_ID=
# Microsoft Clarity 代碼（選填，未啟用可留空）
NUXT_PUBLIC_CLARITY_CODE=

# ===== 後端（啟用 server/ 後再填，純前端樣板可忽略）=====
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=dbname
# Cloudflare R2 物件儲存
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=your-bucket
